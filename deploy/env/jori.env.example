# /etc/jori/jori.env 로 복사해 쓴다(소유 root:jori, 권한 0640). 이 파일은 예시이며 비밀값은 넣지 않는다.
# CHANGE_ME는 서버에서 직접 채우는 비밀값, TBD는 계약·결정 전이라 값을 지어내지 않은 칸이다.
# 운영(production)은 PG·문자 공급자가 모의(mock)이거나 TBD이면 기동하지 않는다. 계약 전에는 의도적으로 뜨지 않는다.

JORI_ENVIRONMENT=production
JORI_DATABASE_URL=mysql+pymysql://app_jori:CHANGE_ME@127.0.0.1:3306/jori?charset=utf8mb4
JORI_SITE_ID=jori
JORI_SECRET_KEY=CHANGE_ME_32자_이상_무작위_문자열을_서버에서_생성
JORI_COOKIE_SECURE=1

# 첨부 파일(웹 루트 밖). 서비스 계정만 쓸 수 있다
JORI_FILE_ROOT=/data/jori/jori/files
JORI_FILE_SCANNER=clamd
JORI_CLAMD_HOST=127.0.0.1
JORI_CLAMD_PORT=3310

# 외부 업체. 계약 후에 정한다(PRD Q1~Q4). 값을 지어내지 않는다
JORI_PG_PROVIDER=TBD
JORI_PG_MERCHANT_ID=TBD
JORI_SMS_PROVIDER=TBD
JORI_SMS_SENDER_NUMBER=TBD

# DB 커넥션 풀(프로세스마다). (풀+초과) x (API 프로세스 수+워커 1)+20이 MariaDB max_connections 안이어야 한다
# 부하 시험 전의 가정값이다. 시험 결과로 조정한다
JORI_DB_POOL_SIZE=10
JORI_DB_MAX_OVERFLOW=10
JORI_DB_POOL_TIMEOUT=10

# 워커 상태 파일. 유닛의 RuntimeDirectory 안이다
JORI_WORKER_STATUS_FILE=/run/jori/jori/worker-status.json

# 배포 절차가 빌드의 커밋 해시를 넣는다. /api/health/version이 검수 기록과 대조하라고 보인다
JORI_BUILD_COMMIT=CHANGE_ME_배포한_커밋_해시

# API 유닛만 읽는 값(앱 설정이 아니다)
JORI_API_PORT=8001
JORI_API_WORKERS=4
