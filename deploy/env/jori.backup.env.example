# /etc/jori/jori.backup.env 로 복사해 쓴다(소유 root, 권한 0600). 백업·복구시험 스크립트만 읽는다. 초안이다(ADR-102).
JORI_BACKUP_DIR=/var/backups/jori/jori
# 백업 암호화 키 파일. 무작위 32바이트 이상을 서버에서 만들고(예: openssl rand -base64 48), 키는 백업과 다른 곳에도 보관한다
JORI_BACKUP_KEYFILE=/etc/jori/jori.backup.key
# mariabackup 접속 정보(계정 backup_jori). 비밀번호는 이 옵션 파일에만 둔다(권한 0600)
JORI_BACKUP_DEFAULTS_FILE=/etc/jori/jori.backup.cnf
JORI_FILE_ROOT=/data/jori/jori/files
JORI_BINLOG_DIR=/var/lib/mysql
# 별도 저장소. 정해지기 전에는 비워 둔다(로컬에만 보관). 예: backup@저장소주소:/backup/jori
JORI_BACKUP_DEST=
JORI_BACKUP_KEEP_DAYS=30
JORI_RESTORE_PORT=3307
