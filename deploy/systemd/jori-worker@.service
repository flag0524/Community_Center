# 자치회 인스턴스마다 하나만 띄우는 워커 유닛(ADR-004 단일 인스턴스). 예: systemctl enable --now jori-worker@jori
# 워커가 15초마다 WATCHDOG=1을 보내고, 60초 동안 없으면 systemd가 다시 시작한다(ADR-027).
[Unit]
Description=조리읍 주민자치센터 수강시스템 워커 (%i)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=jori
Group=jori
WorkingDirectory=/opt/jori/current/apps/api
EnvironmentFile=/etc/jori/%i.env
# 상태 파일 위치(JORI_WORKER_STATUS_FILE)는 이 폴더 안이다. 재시작하면 지워지고 워커가 다시 만든다
RuntimeDirectory=jori/%i
RuntimeDirectoryPreserve=no
ExecStart=/opt/jori/venv/bin/python -m app.worker
WatchdogSec=60
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/jori/%i

[Install]
WantedBy=multi-user.target
