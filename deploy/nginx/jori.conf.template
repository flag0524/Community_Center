# 자치회 1곳의 Nginx 사이트. {{DOMAIN}}과 {{API_PORT}}를 바꿔 /etc/nginx/sites-available/jori.conf 로 둔다.
# 도메인·인증서는 아직 정해지지 않았다. 예시 값(example.org)을 그대로 쓰지 않는다.
# 주민 앱은 user.{{DOMAIN}}, 관리자 앱은 admin.{{DOMAIN}}, 둘 다 /api는 같은 API 프로세스로 보낸다.

upstream jori_api {
    server 127.0.0.1:{{API_PORT}};
    keepalive 16;
}

server {
    listen 80;
    server_name user.{{DOMAIN}} admin.{{DOMAIN}};
    return 301 https://$host$request_uri;
}

# 주민
server {
    listen 443 ssl;
    http2 on;
    server_name user.{{DOMAIN}};
    ssl_certificate     /etc/ssl/jori/fullchain.pem;
    ssl_certificate_key /etc/ssl/jori/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/jori/current/apps/web-user/dist;
    index index.html;
    # 첨부는 파일당 20MB까지 올리고 멀티파트 여유를 둔다
    client_max_body_size 25m;

    include /etc/nginx/snippets/jori-security-headers.conf;

    location /api/ {
        proxy_pass http://jori_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    # 관리자 API는 주민 주소로 열지 않는다
    location /api/admin/ { return 404; }

    # 빌드 산출물은 해시가 붙어 오래 캐시해도 된다. 진입 문서는 캐시하지 않는다
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store";
    }
}

# 관리자
server {
    listen 443 ssl;
    http2 on;
    server_name admin.{{DOMAIN}};
    ssl_certificate     /etc/ssl/jori/fullchain.pem;
    ssl_certificate_key /etc/ssl/jori/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 관리자 접속은 주소로 제한하지 않는다(기관 회신 2026-11-19). 제한이 필요해지면 allow/deny를 이 자리에 더한다.

    root /opt/jori/current/apps/web-admin/dist;
    index index.html;
    client_max_body_size 25m;

    include /etc/nginx/snippets/jori-security-headers.conf;

    location /api/admin/ {
        proxy_pass http://jori_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store";
    }
}

# PG 웹훅은 PG가 부르는 주소라 주민 도메인에서 받는다. 공급자가 정해지면 허용 주소를 제한한다
# (server 블록 user.{{DOMAIN}}의 /api/ 가 이미 /api/pg/webhook/{provider} 를 API로 보낸다)
